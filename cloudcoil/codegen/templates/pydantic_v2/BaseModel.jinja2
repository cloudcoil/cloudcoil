            %} = {% if field.represented_default == "{}" and (field.data_type.reference is not none or (field.data_type.import_ is not none and field.data_type.import_.from_ in external_packages)) %}{{ field.data_type.type_hint }}.model_validate({{ field.represented_default }}){% else %}{{ field.represented_default }}{% endif %}
    {%- endif -%}
    {%- endif %}
    {%- if field.docstring %}
    {{ field.docstring | tojson }}
    {%- endif %}
{%- for method in methods -%}
